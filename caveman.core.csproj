<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  <PackageId>Caveman</PackageId>
  <Version>1.4.5</Version>
  <Authors>Francesco Paolo Passaro</Authors>
  <Company>Francesco Paolo Passaro</Company>
  <Description>NLP Prompt Compressor for LLMs. Reduces token usage by up to 70% using semantic contraction across 50+ languages. Licensed under the Caveman License (MIT + mandatory attribution to Passaro Francesco Paolo - Digitalsolutions.it). Bundled language data derived from Universal Dependencies (see NOTICE).</Description>
  <PackageTags>AI;NLP;LLM;PromptEngineering;Gemma3;MCP;Claude;Copilot</PackageTags>
  <RepositoryUrl>https://github.com/francescopaolopassaro/caveman</RepositoryUrl>
  <PackageReleaseNotes>1.4.5: Synthelion 1.2.5 fixes ported. (1) Structured values (IPs, versions, dates, URLs, e-mails, grouped decimals, percentages) survive every compression level. (2) Chinese/Japanese output is no longer longer than the input. (3) Indentation-based languages (Python, Ruby, shell) are detected as code. (4) Comment stripping is string-aware: it never cuts inside a string literal. (5) Structured-content guard: JSON, code, SQL, HTML, diffs and tables are routed to their structure-aware compressors and YAML/config is returned unchanged instead of being corrupted by the word filters. 1.4.4: Synthelion 1.2.5 feature port. (1) Numeric tokens preserved across every compression level — Semantic/Aggressive/Statistical/Syntactic previously dropped ports, amounts, percentages, versions, dates and temperatures; numbers are now always retained verbatim (never lemmatised). (2) New global-IDF provider and tables: 56 per-language {iso3}.idf.br document-frequency tables (built from Wikipedia, shipped as embedded brotli like the other worddata — same tables as Synthelion 1.2.5, ~128 MB) blended 50/50 into the Statistical level's TF-IDF scoring so word importance is grounded in real-world rarity, and used by Aggressive to additionally drop words ubiquitous in &gt;50% of the reference corpus. Languages without a table fall back to the exact 1.4.3 local-only behavior. (3) SQL-aware compression: new CavemanSqlCompressor — SQL is auto-detected (ContentType.Sql) and routed away from the NLP path into a lossless whitespace/formatting collapse that protects keywords, string/numeric literals, quoted identifiers and comments; optional VALUES-tuple folding (lossy, CCR-hashed) mirrors CavemanJsonCrusher's row-drop. All changes additive and backward-compatible. Includes full 1.4.2/1.4.3 history below: 1.4.3 was a corrective re-publish of 1.4.2 (previously the 1.4.2 NuGet package was packed from a stale snapshot missing 1.4.0/1.4.1 features), carrying the language-quality pass ported back from Synthelion 1.2.0, negation-particle protection (eng/ita/fra/spa/deu/por/zho), the Italian "subito" ADV-homograph lemma fix, CavemanCjkSegmenter (jieba-style dictionary Chinese segmentation), mojibake repair in worddata/zho* and 10 further languages, and language-detection data contamination fixes ("john"/"ha"/"e"/"ate").</PackageReleaseNotes>
  
  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Caveman</Title>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Primary public API is documented; suppress "missing XML comment" for the rest. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Copyright>Copyright (c) 2026 Passaro Francesco Paolo - Digitalsolutions.it</Copyright>
    <PackageProjectUrl>https://github.com/francescopaolopassaro/caveman/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
<PropertyGroup>
  <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  <PackageIcon>caveman-icon.png</PackageIcon>
  <PackageLicenseFile>LICENSE</PackageLicenseFile>
  <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
</PropertyGroup>
  <ItemGroup>
    <Compile Remove="console\**" />
    <Compile Remove="tests\**" />
    <Compile Remove="scripts\**" />
    <Compile Remove="mcp\**" />
    <Compile Remove="copilot\**" />
    <EmbeddedResource Remove="console\**" />
    <EmbeddedResource Remove="tests\**" />
    <EmbeddedResource Remove="scripts\**" />
    <EmbeddedResource Remove="mcp\**" />
    <EmbeddedResource Remove="copilot\**" />
    <None Remove="console\**" />
    <None Remove="tests\**" />
    <None Remove="scripts\**" />
    <None Remove="mcp\**" />
    <None Remove="copilot\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Semantic Kernel plugins live in the separate Caveman.SemanticKernel package so the
         core stays dependency-free. The SemanticKernel folder is excluded from compilation. -->
    <Compile Remove="SemanticKernel\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime artifacts produced by scripts/compile-worddata from worddata\*.yaml.
         The .yaml sources stay in the repo but are NOT embedded or packed. -->
    <EmbeddedResource Include="worddata\*.yaml.br" />
    <EmbeddedResource Include="worddata\*.idf.br" />
    <EmbeddedResource Include="worddata\_index.br" />
  </ItemGroup>

  <ItemGroup>
    <None Update="caveman-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="NOTICE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
